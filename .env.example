# Copy to .env and fill in. Never commit .env.

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SQLite locally by default. In production, Postgres on Supabase through its pooler, as a role
# that can only use its own schema:
# postgresql+psycopg://<role>.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=sqlite:///data/macro.db
